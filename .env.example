# Copy to .env.local for local development (npx supabase start prints the local keys).
# On Vercel, set the same names under Project → Settings → Environment Variables.

# public: baked into the web and Mac builds
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=
# the deployed site, used by the Mac app for /api/access and /api/slides (web: leave unset)
VITE_SITE_URL=

# server only: never VITE_-prefixed, never in a bundle
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_SERVICE_ROLE_KEY=
SITE_ACCESS_CODE=
ACCESS_COOKIE_SECRET=
# only for a project still on the legacy shared JWT secret (new projects use signing keys)
SUPABASE_JWT_SECRET=
