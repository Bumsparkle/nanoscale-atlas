{
  "name": "nanoscale-revision",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.gate.config.ts",
    "preview": "vite preview --port 4173",
    "test": "vitest run --exclude '**/*.perf.test.ts' && vitest run src/sim/mesh.perf.test.ts",
    "typecheck": "tsc -b",
    "shots": "node scripts/shots.mjs",
    "slides": "node scripts/render-slides.mjs",
    "dev:app": "NANOSCALE_APP=1 vite",
    "build:app": "tsc -b && NANOSCALE_APP=1 vite build && node scripts/check-app-slides.mjs",
    "tauri": "tauri",
    "app:check": "node scripts/check-app-slides.mjs --binary",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "slides:upload": "node scripts/upload-slides.mjs",
    "auth:push": "node scripts/push-auth-config.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@react-three/fiber": "9.8.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@vercel/functions": "3.10.5",
    "gsap": "3.15.1",
    "jose": "^6.2.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "supabase": "^3.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
