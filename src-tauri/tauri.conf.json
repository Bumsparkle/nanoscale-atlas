{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nanoscale Revision",
  "version": "0.2.0",
  "identifier": "app.nanoscaleatlas.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:app",
    "beforeBuildCommand": "npm run build:app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nanoscale Revision",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 26
        },
        "windowEffects": {
          "effects": [
            "underWindowBackground"
          ],
          "state": "followsWindowActiveState"
        },
        "backgroundColor": [
          0,
          0,
          0,
          0
        ]
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Education",
    "shortDescription": "The CMOS inverter, from wafer to atoms",
    "copyright": "",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 360
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3RERDNEQ5MTBCNTNCNEIKUldSTE83VVEyY1RkOThsYk9hZDBBT0tWK1JPdHhpMllXOXVKVUpvT2poMmpkeGxVcmF1TG1zaUwK",
      "endpoints": [
        "https://github.com/Bumsparkle/nanoscale-atlas/releases/latest/download/latest.json"
      ]
    }
  }
}
